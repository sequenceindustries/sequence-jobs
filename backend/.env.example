APP_ENV=development
DATABASE_URL=postgresql://postgres@/sequence_jobs?host=/tmp&port=5433
CRAWLER_USER_AGENT=SequenceJobsBot/0.1 (+contact: you@yourdomain)

# AI stays OFF until a provider, key AND a non-zero budget are set
AI_PROVIDER=none
AI_API_KEY=
AI_DAILY_BUDGET_USD=0

# Email alerts stay OFF until a provider and key are configured
# Choose one: resend | sendgrid | mailgun | none
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
# For Mailgun only:
EMAIL_MAILGUN_DOMAIN=
